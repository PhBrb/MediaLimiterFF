{
  "manifest_version": 2,
  "name": "MediaLimiter",
  "version": "1.0.0",
  "description": "Limits YouTube Shorts usage to a configurable time per rolling hour and charges time for visits to custom listed sites.",
  "browser_specific_settings": {
    "gecko": {
      "id": "medialimiter@phbrb.dev",
      "strict_min_version": "112.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "*://*/*"
  ],
  "browser_action": {
    "default_title": "MediaLimiter"
  }
}
